OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_MODEL=anthropic/claude-3.5-sonnet
FALLBACK_MODEL=openai/gpt-4o
EMBEDDING_MODEL=all-MiniLM-L6-v2
INTENT_MODEL=all-mpnet-base-v2

DATABASE_URL=postgresql+asyncpg://reasonedai:password@localhost:5432/reasonedai
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=change-this-to-a-very-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

STORAGE_PATH=./storage
CHUNKS_FILE=./storage/chunks.json
FILES_META=./storage/files_meta.json
EMBEDDINGS_FILE=./storage/embeddings.npy
FAISS_INDEX=./storage/faiss.index

MAX_UPLOAD_SIZE_MB=100
OCR_ENABLED=true
TESSERACT_CMD=/usr/bin/tesseract

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

CHROMA_HOST=localhost
CHROMA_PORT=8001

CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

ENVIRONMENT=development
LOG_LEVEL=INFO
MOCK_LLM=false
